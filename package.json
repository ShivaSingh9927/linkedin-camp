{
    "name": "linkedin-camp-monorepo",
    "private": true,
    "packageManager": "npm@10.2.4",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "lint": "turbo run lint",
        "test:copilot-harness": "npm --workspace backend run test:copilot-harness && npm --workspace web run test:copilot-harness",
        "harness:copilot": "npm --workspace backend run harness:copilot"
    },
    "devDependencies": {
        "@prisma/client": "^6.0.1",
        "prisma": "^6.0.1",
        "turbo": "latest",
        "typescript": "latest"
    },
    "dependencies": {
        "@ai-sdk/groq": "^3.0.31",
        "@langchain/ollama": "^1.2.5",
        "ai": "^6.0.141",
        "dotenv": "^17.3.1",
        "jsdom": "^29.1.1",
        "motion": "^12.40.0"
    }
}
