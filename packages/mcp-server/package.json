{
  "name": "@qampi/mcp-server",
  "version": "0.1.0",
  "description": "Qampi MCP server \u2014 drive LinkedIn outreach from Claude Code, Codex, Cursor or any MCP client.",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "qampi-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=esm --packages=external --outfile=dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node test/smoke.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "esbuild": "^0.24.0"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "linkedin",
    "outreach",
    "qampi",
    "claude-code",
    "cursor",
    "codex",
    "automation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShivaSingh9927/linkedin-camp.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://github.com/ShivaSingh9927/linkedin-camp/tree/main/packages/mcp-server#readme",
  "bugs": {
    "url": "https://github.com/ShivaSingh9927/linkedin-camp/issues"
  },
  "publishConfig": {
    "access": "public"
  }
